<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Management LANs often use RouterOS API on TCP 8728 without TLS. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
